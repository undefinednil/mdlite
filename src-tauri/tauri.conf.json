{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdlite",
  "version": "0.1.0",
  "identifier": "dev.mdlite.app",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdlite",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Visible",
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local markdown workspace",
    "longDescription": "Browse, search and edit a folder of Markdown notes with Vim keybindings, Mermaid diagrams and Excalidraw drawings."
  }
}
